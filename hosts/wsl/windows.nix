# 同一 PC の Windows 側 git を WSL の home-manager から生成し、鍵・agent・ghtkn・hooks を WSL の 1 系統に寄せる。
# Windows に秘密鍵や長期 token を置かず、Windows 固有の差分はここだけに閉じ込める。
{
  config,
  lib,
  pkgs,
  ...
}:

let
  home = config.home.homeDirectory;
  distro = "NixOS";
  winHome = "/mnt/c/Users/accou";
  # Windows からは UNC で WSL の生成物を参照する
  unc = p: "//wsl.localhost/${distro}${p}";
  bridgeDir = "${home}/.local/share/git-win";
  winBridgeDir = "${winHome}/.config/git/wsl";
  hookNames = [
    "pre-commit"
    "commit-msg"
    "pre-push"
    "post-checkout"
    "post-commit"
    "post-merge"
  ];

  # Windows git が渡す C:/... や //wsl.localhost/... の引数を Linux パスに直してから実体を呼ぶ
  translate = ''
    args=()
    for a in "$@"; do
      case "$a" in
        //wsl.localhost/${distro}/*) args+=("/''${a#//wsl.localhost/${distro}/}") ;;
        [A-Za-z]:[\\/]*) args+=("$(/bin/wslpath -u "$a")") ;;
        *) args+=("$a") ;;
      esac
    done
  '';

  signBridge = pkgs.writeShellScript "ssh-keygen-sign-win" ''
    ${translate}
    exec ${config.programs.git.signing.signer} "''${args[@]}"
  '';

  credentialBridge = pkgs.writeShellScript "ghtkn-credential-win" ''
    exec ${pkgs.ghtkn}/bin/ghtkn git-credential "$@"
  '';

  # Windows 側に置く shebang script。Git for Windows は #! を解釈して sh で実行する
  winShim = target: ''
    #!/bin/sh
    exec wsl.exe -d ${distro} -e ${target} "$@"
  '';

  winHook = name: ''
    #!/bin/sh
    hook=${config.xdg.configHome}/git/hooks/${name}
    exec wsl.exe -d ${distro} --cd "$(pwd)" -e sh -c '[ -x "$0" ] || exit 0; exec "$0" "$@"' "$hook" "$@"
  '';

  winGitconfig = pkgs.writeText "gitconfig-windows" ''
    # Generated by HikaruEgashira/dotfiles hosts/wsl/windows.nix. Do not edit; edit the dotfiles instead.
    [include]
    	path = ${unc "${config.xdg.configHome}/git/config"}
    [core]
    	hooksPath = C:/Users/accou/.config/git/wsl/hooks
    	editor = notepad
    [gpg "ssh"]
    	program = C:/Users/accou/.config/git/wsl/ssh-keygen
    	allowedSignersFile = ${unc "${config.xdg.configHome}/git/allowed_signers"}
    [credential "https://github.com"]
    	helper =
    	helper = C:/Users/accou/.config/git/wsl/git-credential-ghtkn
    [credential "https://gist.github.com"]
    	helper =
    	helper = C:/Users/accou/.config/git/wsl/git-credential-ghtkn
    [filter "lfs"]
    	clean = git-lfs clean -- %f
    	smudge = git-lfs smudge -- %f
    	process = git-lfs filter-process
  '';
in
{
  home = {
    file.".local/share/git-win/ssh-keygen-sign".source = signBridge;
    file.".local/share/git-win/git-credential-ghtkn".source = credentialBridge;

    # /mnt/c は home.file の管理外なので activation で書く。初回だけ手書き版を退避する
    activation.windowsGit = lib.hm.dag.entryAfter [ "linkGeneration" ] ''
      if [ -d ${winHome} ]; then
        if [ -f ${winHome}/.gitconfig ] && ! grep -q 'hosts/wsl/windows.nix' ${winHome}/.gitconfig; then
          $DRY_RUN_CMD cp ${winHome}/.gitconfig ${winHome}/.gitconfig.pre-dotfiles
        fi
        $DRY_RUN_CMD mkdir -p ${winBridgeDir}/hooks
        $DRY_RUN_CMD cp --no-preserve=mode ${winGitconfig} ${winHome}/.gitconfig
        $DRY_RUN_CMD cp --no-preserve=mode ${pkgs.writeText "ssh-keygen" (winShim "${bridgeDir}/ssh-keygen-sign")} ${winBridgeDir}/ssh-keygen
        $DRY_RUN_CMD cp --no-preserve=mode ${pkgs.writeText "git-credential-ghtkn" (winShim "${bridgeDir}/git-credential-ghtkn")} ${winBridgeDir}/git-credential-ghtkn
        ${lib.concatMapStrings (n: ''
          $DRY_RUN_CMD cp --no-preserve=mode ${pkgs.writeText n (winHook n)} ${winBridgeDir}/hooks/${n}
        '') hookNames}
      fi
    '';
  };
}

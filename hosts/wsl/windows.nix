# 同一 PC の Windows 側 git を WSL の home-manager から生成し、鍵・agent・ghtkn・hooks を WSL の 1 系統に寄せる。
# Windows に秘密鍵や長期 token を置かず、Windows 固有の差分はここだけに閉じ込める。
# Windows のユーザーと distro 名は PC ごとに違うため、eval 時に固定せず activation 時に解決して @WINHOME@ / @DISTRO@ へ埋める。
# WSL が止まっていても、UNC 参照と wsl.exe 呼び出しは distro を自動起動するので Windows 側から壊れない。
{
  config,
  lib,
  pkgs,
  ...
}:

let
  home = config.home.homeDirectory;
  # Windows からは UNC で WSL の生成物を参照する
  unc = p: "//wsl.localhost/@DISTRO@${p}";
  bridgeDir = "${home}/.local/share/git-win";
  hookNames = [
    "pre-commit"
    "commit-msg"
    "pre-push"
    "post-checkout"
    "post-commit"
    "post-merge"
  ];

  # Windows git が渡す C:/... や //wsl.localhost/<distro>/... の引数を Linux パスに直してから実体を呼ぶ
  translate = ''
    args=()
    for a in "$@"; do
      case "$a" in
        //wsl.localhost/"$WSL_DISTRO_NAME"/*) args+=("/''${a#//wsl.localhost/"$WSL_DISTRO_NAME"/}") ;;
        [A-Za-z]:[\\/]*) args+=("$(/bin/wslpath -u "$a")") ;;
        *) args+=("$a") ;;
      esac
    done
  '';

  signBridge = pkgs.writeShellScript "ssh-keygen-sign-win" ''
    ${translate}
    exec ${config.programs.git.signing.signer} "''${args[@]}"
  '';

  credentialBridge = pkgs.writeShellScript "ghtkn-credential-win" ''
    exec ${pkgs.ghtkn}/bin/ghtkn git-credential "$@"
  '';

  # Windows 側に置く shebang script。Git for Windows は #! を解釈して sh で実行する
  winShim =
    name: target:
    pkgs.writeText name ''
      #!/bin/sh
      exec wsl.exe -d @DISTRO@ -e ${target} "$@"
    '';

  winHook =
    name:
    pkgs.writeText name ''
      #!/bin/sh
      hook=${config.xdg.configHome}/git/hooks/${name}
      exec wsl.exe -d @DISTRO@ --cd "$(pwd)" -e sh -c '[ -x "$0" ] || exit 0; exec "$0" "$@"' "$hook" "$@"
    '';

  winGitconfig = pkgs.writeText "gitconfig-windows" ''
    # Generated by HikaruEgashira/dotfiles hosts/wsl/windows.nix. Do not edit; edit the dotfiles instead.
    [include]
    	path = ${unc "${config.xdg.configHome}/git/config"}
    [core]
    	hooksPath = @WINHOME@/.config/git/wsl/hooks
    	editor = notepad
    [gpg "ssh"]
    	program = @WINHOME@/.config/git/wsl/ssh-keygen
    	allowedSignersFile = ${unc "${config.xdg.configHome}/git/allowed_signers"}
    [credential "https://github.com"]
    	helper =
    	helper = @WINHOME@/.config/git/wsl/git-credential-ghtkn
    [credential "https://gist.github.com"]
    	helper =
    	helper = @WINHOME@/.config/git/wsl/git-credential-ghtkn
    [filter "lfs"]
    	clean = git-lfs clean -- %f
    	smudge = git-lfs smudge -- %f
    	process = git-lfs filter-process
  '';

  # src を placeholder 置換して Windows 側へ書く。置換は一時ファイルで行い、dry-run でも書き込みは cp だけに限る
  render = src: dst: ''
    tmp=$(mktemp)
    ${pkgs.gnused}/bin/sed -e "s|@WINHOME@|$winHomeMixed|g" -e "s|@DISTRO@|$WSL_DISTRO_NAME|g" ${src} > "$tmp"
    $DRY_RUN_CMD cp "$tmp" "${dst}"
    rm -f "$tmp"
  '';
in
{
  home = {
    file.".local/share/git-win/ssh-keygen-sign".source = signBridge;
    file.".local/share/git-win/git-credential-ghtkn".source = credentialBridge;

    # /mnt/c は home.file の管理外なので activation で書く。初回だけ手書き版を退避する。
    # interop が無い (Windows を解決できない) 環境では何もしない
    activation.windowsGit = lib.hm.dag.entryAfter [ "linkGeneration" ] ''
      winProfile=$(/mnt/c/Windows/System32/cmd.exe /d /c 'echo %USERPROFILE%' 2>/dev/null | ${pkgs.coreutils}/bin/tr -d '\r' || true)
      if [ -n "''${WSL_DISTRO_NAME:-}" ] && [ -n "$winProfile" ]; then
        winHome=$(/bin/wslpath -u "$winProfile")
        # wslpath -m は Windows 形式の入力だと区切りを落とすので、Linux パスから変換する
        winHomeMixed=$(/bin/wslpath -m "$winHome")
        if [ -f "$winHome/.gitconfig" ] && ! grep -q 'hosts/wsl/windows.nix' "$winHome/.gitconfig"; then
          $DRY_RUN_CMD cp "$winHome/.gitconfig" "$winHome/.gitconfig.pre-dotfiles"
        fi
        $DRY_RUN_CMD mkdir -p "$winHome/.config/git/wsl/hooks"
        ${render winGitconfig "$winHome/.gitconfig"}
        ${render (winShim "ssh-keygen" "${bridgeDir}/ssh-keygen-sign") "$winHome/.config/git/wsl/ssh-keygen"}
        ${render (winShim "git-credential-ghtkn" "${bridgeDir}/git-credential-ghtkn") "$winHome/.config/git/wsl/git-credential-ghtkn"}
        ${lib.concatMapStrings (n: render (winHook n) "$winHome/.config/git/wsl/hooks/${n}") hookNames}
      else
        echo "windowsGit: Windows interop unavailable; skipping Windows git config" >&2
      fi
    '';
  };
}

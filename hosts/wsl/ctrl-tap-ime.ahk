; 左 Ctrl 単押し (他キー・クリックと組み合わせず離した時) で IME の ON/OFF を切り替える
#Requires AutoHotkey v2.0
#SingleInstance Force
InstallKeybdHook
InstallMouseHook
DetectHiddenWindows true

~LControl up:: {
    if (A_PriorKey = "LControl")
        ToggleIME()
}

ToggleIME() {
    hwnd := WinExist("A")
    try hwnd := ControlGetFocus("A") || hwnd
    ime := DllCall("imm32\ImmGetDefaultIMEWnd", "Ptr", hwnd, "Ptr")
    if !ime
        return
    ; WM_IME_CONTROL: 0x5 = IMC_GETOPENSTATUS, 0x6 = IMC_SETOPENSTATUS
    open := SendMessage(0x283, 0x5, 0, ime)
    SendMessage(0x283, 0x6, !open, ime)
}

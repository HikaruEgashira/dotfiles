; Generated by HikaruEgashira/dotfiles hosts/wsl/ime.nix. Do not edit; edit the dotfiles instead.
; Mac の英数/かな と同じく、左 Win(Cmd) 単押しで IME OFF、右 Win(Cmd) 単押しで IME ON にする
#Requires AutoHotkey v2.0
#SingleInstance Force
InstallKeybdHook
InstallMouseHook
DetectHiddenWindows true
; Win 単押しでスタートメニューが開くのを vkE8 (未割当キー) で抑止する
A_MenuMaskKey := "vkE8"

~LWin up:: {
    if (A_PriorKey = "LWin")
        SetIME(0)
}

~RWin up:: {
    if (A_PriorKey = "RWin")
        SetIME(1)
}

SetIME(open) {
    hwnd := WinExist("A")
    try hwnd := ControlGetFocus("A") || hwnd
    ime := DllCall("imm32\ImmGetDefaultIMEWnd", "Ptr", hwnd, "Ptr")
    if !ime
        return
    ; WM_IME_CONTROL 0x6 = IMC_SETOPENSTATUS
    SendMessage(0x283, 0x6, open, ime)
}

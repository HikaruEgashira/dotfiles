; Generated by HikaruEgashira/dotfiles hosts/wsl/ime.nix. Do not edit; edit the dotfiles instead.
; Mac の英数/かな と同じく、左 Alt 単押しで IME OFF、右 Alt 単押しで IME ON にする
#Requires AutoHotkey v2.0
#SingleInstance Force
InstallKeybdHook
InstallMouseHook
DetectHiddenWindows true
; Alt 単押しでメニューバーにフォーカスが移るのを vkE8 (未割当キー) で抑止する
A_MenuMaskKey := "vkE8"

~LAlt up:: {
    if (A_PriorKey = "LAlt")
        SetIME(0)
}

~RAlt up:: {
    if (A_PriorKey = "RAlt")
        SetIME(1)
}

SetIME(open) {
    hwnd := WinExist("A")
    try hwnd := ControlGetFocus("A") || hwnd
    ime := DllCall("imm32\ImmGetDefaultIMEWnd", "Ptr", hwnd, "Ptr")
    if !ime
        return
    ; WM_IME_CONTROL 0x6 = IMC_SETOPENSTATUS
    SendMessage(0x283, 0x6, open, ime)
}
